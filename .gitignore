# .gitignore
# ============================================================
# 起名项目 - Git 忽略文件
# ============================================================

# ===== 依赖目录 =====
# 根目录（脚本/工具用，如 playwright）
node_modules/
.pnpm-store/
.pnp
.pnp.js

# 后端
backend/vendor/
backend/*.exe
backend/namer-*
backend/*.prof
backend/coverage.*

# Go 构建缓存（本机 GOCACHE 指向工作区时产生）
.gocache/

# 前端
frontend/node_modules/
# docs/45 P1-31：next.config.js 的 distDir 已从 'out' 分离回默认 '.next'，
# 编译中间产物（dev/server/build/logs/trace）只落在此目录，绝不入库。
frontend/.next/
# 静态导出交付目录（本地产物，由 next build / start-server.sh 重建）
frontend/out/
frontend/dist/
frontend/build/
frontend/.turbo/
frontend/.cache/
frontend/coverage/
# E2E 生成报告（非源码，可随时复跑生成）
frontend/.e2e/

# ===== 数据文件 (运行时生成) =====
# SQLite 数据库
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/
*.backup
# data/ 下的 JSON/CSV 是 tools/build_seed 的构建期输入，不入库、不随包分发。
# 单库路线（ADR-010「A + 单库」）：测试 / CI 门禁 / 运行期 / NSIS 安装包
# 只认下面这一份二进制种子库；此前为 CI 白名单入库的 11 个 JSON（17MB）
# 已全部退役 —— 它们造成 golden 快照随入库物料子集漂移（远端 quality-fast 长期红）。
data/*
!data/namer.db

# 日志文件
logs/
*.log
*.log.*
backend/logs/
frontend/logs/
nginx/logs/

# 临时文件
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~

# 工具运行时状态与持久化产物
.omo/
.workbuddy/
backend/.omo/
backend/cli_output.json
backend/server.pid
backend/memory
backend/memory-shm
backend/memory-wal

# TypeScript 增量缓存
*.tsbuildinfo

# Go 覆盖率输出（非标准路径）
backend/coverage

# 环境变量 (包含敏感信息)
.env
.env.*
!.env.example
!.env.template
!.env.production.example
!.env.development.example

# IDE/编辑器配置
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# 操作系统文件
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 构建产物
*.exe
*.dll
*.so
*.dylib
*.out
*.test

# 测试覆盖率
coverage/
.nyc_output/
*.lcov

# 证书/密钥 (敏感)
*.pem
*.key
*.crt
*.p12
*.pfx
certbot/conf/
*.pem

# Docker
.docker/
docker-compose.override.yml

# 备份文件
*.tar.gz
*.tgz
*.zip
/opt/backups/

# 部署脚本 (包含敏感信息)
deploy.sh.local

# 语言服务器缓存
.lsp/
.ccls-cache/

# 语言特定
# Go
go.work

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Python
__pycache__/
*.py[cod]
*$py.class

# Rust
target/
Cargo.lock

# Java
*.class
*.jar
*.war
*.ear
hs_err_pid*.log

# 其他
*.orig
*.rej
*.patch
*.diff
# go test 覆盖率输出产物
go-coverage-*.txt
go-test-result.txt
# 本地覆盖率明细报告（go test -coverprofile 生成，可随时重新生成）
cover-func.txt

# Wails v3 构建副产物（wails3 build / package 自动生成，可随时重建）
/frontend/package.json.md5
/backend/assets/
# frontend/dist 的产物由 scripts/sync-dist.mjs 同步进 Go embed 目录；
# 只保留 .gitkeep，避免 embed 目录在干净检出时不存在（go build 直接失败）。
/backend/frontend/dist/*
!/backend/frontend/dist/.gitkeep
/backend/bin/
/backend/build/windows/nsis/MicrosoftEdgeWebview2Setup.exe
/backend/build/windows/nsis/tmp/
*.syso

# Playwright e2e 产物（frontend/e2e 运行生成，可随时重建）
/frontend/test-results/
/frontend/playwright-report/
