# .gitignore
# ============================================================
# 起名项目 - Git 忽略文件
# ============================================================

# ===== 依赖目录 =====
# 根目录（脚本/工具用，如 playwright）
node_modules/
.pnpm-store/
.pnp
.pnp.js

# 后端
backend/vendor/
backend/*.exe
backend/namer-*
backend/*.prof
backend/coverage.*

# 前端
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/dist/
frontend/build/
frontend/.turbo/
frontend/.cache/
frontend/coverage/

# ===== 数据文件 (运行时生成) =====
# SQLite 数据库
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backend/data/
*.backup

# 日志文件
logs/
*.log
*.log.*
backend/logs/
frontend/logs/
nginx/logs/

# 临时文件
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
*~

# 工具运行时状态与持久化产物
.omo/
.workbuddy/
backend/.omo/
backend/cli_output.json
backend/server.pid
backend/memory
backend/memory-shm
backend/memory-wal

# TypeScript 增量缓存
*.tsbuildinfo

# Go 覆盖率输出（非标准路径）
backend/coverage

# 环境变量 (包含敏感信息)
.env
.env.*
!.env.example
!.env.template
!.env.production.example
!.env.development.example

# IDE/编辑器配置
.idea/
.vscode/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# 操作系统文件
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# 构建产物
*.exe
*.dll
*.so
*.dylib
*.out
*.test

# 测试覆盖率
coverage/
.nyc_output/
*.lcov

# 证书/密钥 (敏感)
*.pem
*.key
*.crt
*.p12
*.pfx
certbot/conf/
*.pem

# Docker
.docker/
docker-compose.override.yml

# 备份文件
*.tar.gz
*.tgz
*.zip
/opt/backups/

# 部署脚本 (包含敏感信息)
deploy.sh.local

# 语言服务器缓存
.lsp/
.ccls-cache/

# 语言特定
# Go
go.work

# Node.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Python
__pycache__/
*.py[cod]
*$py.class

# Rust
target/
Cargo.lock

# Java
*.class
*.jar
*.war
*.ear
hs_err_pid*.log

# 其他
*.orig
*.rej
*.patch
*.diff
# go test 覆盖率输出产物
go-coverage-*.txt
go-test-result.txt
