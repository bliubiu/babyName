# backend/.dockerignore
# ============================================================
# 构建上下文忽略文件 - 减少构建上下文大小，加速构建
# ============================================================

# Git 相关
.git
.gitignore
.github

# IDE/编辑器配置
.idea
.vscode
*.swp
*.swo
*~

# 构建产物
*.exe
*.out
*.test
namer-server
namer-cli
*.prof

# 依赖目录
vendor/

# 数据文件 (运行时挂载，构建时不需要)
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 日志文件
logs/
*.log

# 临时文件
tmp/
*.tmp
*.temp

# 配置文件 (运行时挂载)
config/local.yaml
config/production.yaml
.env
.env.*

# 测试覆盖率
coverage.out
coverage.html

# 文档
*.md
docs/

# 脚本
scripts/
*.sh
*.bat
*.ps1

# 基准测试
bench_*

# 工具目录
tools/
cmd/*/main.go.bak

# 其他
.DS_Store
Thumbs.db