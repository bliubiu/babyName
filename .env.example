# .env.example
# ============================================================
# 环境变量配置示例
# 复制为 .env.production 或 .env.development 并修改对应值
# ============================================================

# ===== 通用配置 =====
COMPOSE_PROJECT_NAME=namer
TZ=Asia/Shanghai

# ===== 后端配置 =====
GIN_MODE=release
PORT=8080
DATA_DIR=/app/data
LOG_LEVEL=info
LOG_DIR=/app/logs

# 注意：JWT_SECRET / JWT_EXPIRE 是历史遗留死配置，后端无任何鉴权实现，
# 设置它们不产生保护作用。公网暴露请在 Nginx/网关层做访问控制（docs/29 B14）。
# 如需应用层鉴权，请先确认需求范围再实现。

# 数据库配置 (默认 SQLite，可选 PostgreSQL)
# DSN=postgres://namer:secure_password@postgres:5432/namer?sslmode=disable

# Redis 缓存/会话 (可选)
# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# 邮件服务 (可选)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=namer@example.com
# SMTP_PASSWORD=
# SMTP_FROM=起名工具 <namer@example.com>

# ===== 前端配置 =====
NODE_ENV=production
NEXT_PUBLIC_API_BASE=https://api.your-domain.com
NEXT_PUBLIC_WS_BASE=wss://api.your-domain.com
NEXT_PUBLIC_APP_NAME=起名工具
NEXT_PUBLIC_APP_VERSION=1.0.0

# ===== Nginx / SSL 配置 =====
NGINX_SSL_EMAIL=admin@your-domain.com
NGINX_DOMAIN=your-domain.com

# ===== 监控/日志 (可选) =====
# LOGGING_LEVEL=info
# METRICS_ENABLED=true
# JAEGER_ENDPOINT=http://jaeger:14268/api/traces