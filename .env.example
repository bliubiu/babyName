# .env.example
# ============================================================
# 环境变量配置示例
# 复制为 .env.production 或 .env.development 并修改对应值
# ============================================================

# ===== 通用配置 =====
COMPOSE_PROJECT_NAME=namer
TZ=Asia/Shanghai

# ===== 后端配置 =====
GIN_MODE=release
PORT=8080
DATA_DIR=/app/data
LOG_LEVEL=info
LOG_DIR=/app/logs

# 注意：JWT_SECRET / JWT_EXPIRE 是历史遗留死配置，后端无任何鉴权实现，
# 设置它们不产生保护作用。公网暴露请在 Nginx/网关层做访问控制（docs/29 B14）。
# 如需应用层鉴权，请先确认需求范围再实现。

# 数据库配置 (默认 SQLite，可选 PostgreSQL)
# DSN=postgres://namer:secure_password@postgres:5432/namer?sslmode=disable

# Redis 缓存/会话 (可选)
# REDIS_ADDR=redis:6379
# REDIS_PASSWORD=
# REDIS_DB=0

# 邮件服务 (可选)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=namer@example.com
# SMTP_PASSWORD=
# SMTP_FROM=起名工具 <namer@example.com>

# ===== 前端配置 =====
# NEXT_PUBLIC_API_URL 为构建期变量（frontend Dockerfile ARG，output:'export'
# 静态导出把值烘焙进产物 JS），经 docker-compose.yml frontend build.args 注入。
# 留空/删除 → 前端走同源推导（外层 nginx 反代 /api，docs/08，推荐形态）；
# 跨域 API 才需要完整前缀（含 /api）。
#NEXT_PUBLIC_API_URL=https://api.your-domain.com/api

# ===== 监控/日志 (可选) =====
# LOGGING_LEVEL=info
# METRICS_ENABLED=true
# JAEGER_ENDPOINT=http://jaeger:14268/api/traces